<idea-plugin>
    <id>com.codereview.annotator</id>
    <name>Code Review Annotator</name>
    <version>0.1.1</version>
    <vendor>Code Review</vendor>
    <description><![CDATA[
        Add review comments on diffs right from your IDE on a line, a file, or the whole review.
        When you're done, export everything as markdown you can paste into a PR, a chat, or an AI agent.
        Comments show up inline in the editor and persist across restarts.
        <br/><br/>
        Inspired by <a href="https://github.com/agavra/tuicr">tuicr</a>.
    ]]></description>

    <change-notes><![CDATA[
        Initial release.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>com.intellij.platform.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.codereview.service.ReviewSessionService"/>

        <applicationConfigurable parentId="tools"
                                 instance="com.codereview.settings.CodeReviewConfigurable"
                                 id="com.codereview.settings"
                                 displayName="Code Review Annotator"/>

        <toolWindow id="Code Review"
                    anchor="bottom"
                    factoryClass="com.codereview.toolwindow.ReviewToolWindowFactory"
                    icon="AllIcons.Actions.Annotate"/>

        <notificationGroup id="CodeReviewAnnotator"
                           displayType="BALLOON"
                           toolWindowId="Code Review"/>

        <postStartupActivity implementation="com.codereview.editor.ReviewEditorListenerStartup"/>
        <postStartupActivity implementation="com.codereview.decoration.ChangesTreeDecoratorInstaller"/>
    </extensions>

    <actions>
        <!-- Review-wide comment from tool window toolbar -->
        <action id="CodeReview.AddReviewComment"
                class="com.codereview.actions.AddReviewCommentAction"
                text="Add Review Comment"
                description="Add a review-wide comment">
        </action>

        <action id="CodeReview.ExportToClipboard"
                class="com.codereview.actions.ExportToClipboardAction"
                text="Copy Review"
                description="Copy all review comments as markdown to the clipboard">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt E"/>
        </action>

        <action id="CodeReview.ClearSession"
                class="com.codereview.actions.ClearSessionAction"
                text="Clear Session"
                description="Clear all review comments">
        </action>

        <action id="CodeReview.ExportToTerminal"
                class="com.codereview.actions.ExportToTerminalAction"
                text="Submit Review"
                description="Submit all review comments to the terminal">
            <add-to-group group-id="TerminalToolwindowActionGroup" anchor="last"/>
        </action>

        <action id="CodeReview.ShowHistory"
                class="com.codereview.actions.ShowReviewHistoryAction"
                text="Review History"
                description="Restore a submitted or cleared review">
        </action>

        <action id="CodeReview.ExportToFile"
                class="com.codereview.actions.ExportReviewsToFileAction"
                text="Export Reviews to File..."
                description="Save the current review and the review history to a file">
        </action>

        <action id="CodeReview.ImportFromFile"
                class="com.codereview.actions.ImportReviewsFromFileAction"
                text="Import Reviews from File..."
                description="Load a review and its history from an exported file">
        </action>

        <action id="CodeReview.NextComment"
                class="com.codereview.actions.NextReviewCommentAction"
                text="Next Review Comment"
                description="Go to the next line comment">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt DOWN"/>
        </action>

        <action id="CodeReview.PreviousComment"
                class="com.codereview.actions.PreviousReviewCommentAction"
                text="Previous Review Comment"
                description="Go to the previous line comment">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt UP"/>
        </action>

        <action id="CodeReview.Undo"
                class="com.codereview.actions.UndoReviewChangeAction"
                text="Undo Review Change"
                description="Undo the last change to review comments">
        </action>

        <action id="CodeReview.Redo"
                class="com.codereview.actions.RedoReviewChangeAction"
                text="Redo Review Change"
                description="Redo the last undone change to review comments">
        </action>

        <!-- File comment from Changes view popup -->
        <action id="CodeReview.AddFileComment"
                class="com.codereview.actions.AddFileCommentAction"
                text="Add File Comment..."
                description="Add a review comment on this file">
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </action>

        <!-- Line comment from editor context menu -->
        <action id="CodeReview.AddLineCommentFromEditor"
                class="com.codereview.actions.AddLineCommentFromEditorAction"
                text="Add Review Comment Here..."
                description="Add a review comment on the selected lines">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt C"/>
        </action>

        <!-- Tool window toolbar group -->
        <group id="CodeReview.ToolWindowToolbar">
            <reference ref="CodeReview.ExportToTerminal"/>
            <reference ref="CodeReview.ExportToClipboard"/>
            <reference ref="CodeReview.ClearSession"/>
            <separator/>
            <reference ref="CodeReview.PreviousComment"/>
            <reference ref="CodeReview.NextComment"/>
            <separator/>
            <reference ref="CodeReview.Undo"/>
            <reference ref="CodeReview.Redo"/>
            <reference ref="CodeReview.ShowHistory"/>
            <reference ref="CodeReview.ExportToFile"/>
            <reference ref="CodeReview.ImportFromFile"/>
        </group>
    </actions>
</idea-plugin>
